server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name _;
    root {{ web_root }};
    index index.html;

    access_log /var/log/nginx/studysphere_access.log;
    error_log  /var/log/nginx/studysphere_error.log;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~* \.(css|js)$ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    location ~ /\. {
        deny all;
    }
}
